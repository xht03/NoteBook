$base-style
  h1, .h1
    display: block
    margin-top: 3rem
    margin-bottom: 1rem
    color: $color-accent-1
    letter-spacing: .01em
    font-weight: 700
    font-style: normal
    font-size: 1.5em

    antialias()

  h2
    position: relative
    display: block
    margin-top: 2rem
    margin-bottom: .5rem
    color: $color-accent-1
    text-transform: none
    letter-spacing: normal
    font-weight: bold
    font-size: 1.3rem

  .h2
    position: relative
    display: block
    margin-top: 2rem
    margin-bottom: .5rem
    color: $color-accent-2
    text-transform: none
    letter-spacing: normal
    font-weight: bold
    font-size: 1rem

  h3
    display: block
    margin-top: 1.5rem
    margin-bottom: .5rem
    color: $color-accent-1
    font-weight: bold
    font-size: 1.2rem

  h4
    display: block
    margin-top: 1.2rem
    margin-bottom: .4rem
    color: $color-accent-1
    font-weight: bold
    font-size: 1.1rem

  h5
    display: block
    margin-top: 1rem
    margin-bottom: .4rem
    color: $color-accent-1
    font-weight: bold
    font-size: 1.05rem

  h6
    display: block
    margin-top: 1rem
    margin-bottom: .4rem
    color: $color-accent-1
    font-weight: bold
    font-size: 1rem

  hr
    border: .5px dashed $color-accent-3
    opacity: .5
    margin: 0
    margin-top: 20px
    margin-bottom: 20px

  strong
    font-weight: bold

  em
  cite
    font-style: italic

  sup
  sub
    position: relative
    vertical-align: baseline
    font-size: .75em
    line-height: 0

  sup
    top: -.5em

  sub
    bottom: -.2em

  small
    font-size: .85em

  acronym
  abbr
    border-bottom: 1px dotted

  ul
  ol
  dl
    line-height: $line-height

  ul
  ol
    ul
    ol
      margin-top: 0
      margin-bottom: 0

  ol
    list-style: decimal

  dt
    font-weight: bold

  table
    width: 100%
    border-collapse: collapse
    text-align: left
    font-size: $font-size - 2px

  th
    padding: 8px 10px
    border-bottom: 2px solid $color-border
    color: $color-accent-2
    font-weight: bold
    font-size: $font-size - 1px

  td
    padding: 8px 10px
    border-bottom: 1px dashed rgba($color-border, .5)
    vertical-align: top
